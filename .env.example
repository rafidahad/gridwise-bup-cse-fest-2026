# GridWise configuration template (plan §12, §13.4).
# Copy to .env and fill in real values. NEVER commit a populated .env.
# Every value below is a placeholder, not a credential.

# ---------------------------------------------------------------------------
# Primary interpretation model — Groq (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
GRIDWISE_PRIMARY_API_KEY=replace-with-your-groq-api-key
GRIDWISE_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
GRIDWISE_PRIMARY_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Backup interpretation model — NVIDIA NIM (OpenAI-compatible endpoint)
# Independent provider, so a Groq outage or quota failure does not take the
# backup down with it (plan §6.1).
# ---------------------------------------------------------------------------
GRIDWISE_BACKUP_API_KEY=replace-with-your-nvidia-api-key
GRIDWISE_BACKUP_BASE_URL=https://integrate.api.nvidia.com/v1
GRIDWISE_BACKUP_MODEL=meta/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Inference settings (plan §6.3). Temperature 0 for extraction.
# Seed is best-effort only and is omitted when the provider rejects it.
# ---------------------------------------------------------------------------
GRIDWISE_TEMPERATURE=0
GRIDWISE_SEED=7
GRIDWISE_MAX_OUTPUT_TOKENS=1200

# ---------------------------------------------------------------------------
# Deadlines and call budget (plan §6.1, §11). All seconds.
# GRIDWISE_REQUEST_DEADLINE_S must stay below the judge's 30 s timeout.
# ---------------------------------------------------------------------------
GRIDWISE_REQUEST_DEADLINE_S=25
GRIDWISE_PRIMARY_TIMEOUT_S=9
GRIDWISE_REPAIR_TIMEOUT_S=7
GRIDWISE_BACKUP_TIMEOUT_S=9
GRIDWISE_SOLVER_TIME_LIMIT_S=10

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
GRIDWISE_HOST=0.0.0.0
GRIDWISE_PORT=8000
GRIDWISE_LOG_LEVEL=INFO
