# GridWise configuration template (plan §12, §13.4).
# Copy to .env and fill in real values. NEVER commit a populated .env.
# Every value below is a placeholder, not a credential.

# ---------------------------------------------------------------------------
# Primary interpretation model — Groq (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Several keys may be listed, comma separated. They are rotated when a key is
# rate limited, out of quota, or rejected - which is the cheapest defence
# against the per-key TPM/RPM ceilings during a judging burst. The singular
# name below still works for a single key.
GRIDWISE_PRIMARY_API_KEYS=replace-with-groq-key-1,replace-with-groq-key-2
GRIDWISE_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
GRIDWISE_PRIMARY_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Optional secondary model.
#
# A backup is permitted by Guide S04 but never required, and plan S6.1 calls it
# a reliability feature rather than an obligation. Leave these blank and the
# service skips it: recovery then ends after the primary's targeted repair.
#
# To enable one, point these at any OpenAI-compatible endpoint. A second Groq
# model works and adds a different reading of a note, but it shares Groq's
# availability, so it does not protect against a provider outage.
# ---------------------------------------------------------------------------
GRIDWISE_BACKUP_API_KEYS=
GRIDWISE_BACKUP_BASE_URL=
GRIDWISE_BACKUP_MODEL=

# ---------------------------------------------------------------------------
# Inference settings (plan §6.3). Temperature 0 for extraction.
# Seed is best-effort only and is omitted when the provider rejects it.
# ---------------------------------------------------------------------------
GRIDWISE_TEMPERATURE=0
GRIDWISE_SEED=7
GRIDWISE_MAX_OUTPUT_TOKENS=1200

# ---------------------------------------------------------------------------
# Deadlines and call budget (plan §6.1, §11). All seconds.
# GRIDWISE_REQUEST_DEADLINE_S must stay below the judge's 30 s timeout.
# ---------------------------------------------------------------------------
GRIDWISE_REQUEST_DEADLINE_S=25
GRIDWISE_PRIMARY_TIMEOUT_S=9
GRIDWISE_REPAIR_TIMEOUT_S=7
GRIDWISE_BACKUP_TIMEOUT_S=9
GRIDWISE_SOLVER_TIME_LIMIT_S=10

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
GRIDWISE_HOST=0.0.0.0
GRIDWISE_PORT=8000
GRIDWISE_LOG_LEVEL=INFO
